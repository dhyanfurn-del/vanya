{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/vendor",
      "destination": "/VANYAVEN/index.html"
    },
    {
      "source": "/admin",
      "destination": "/VANYAVEN/index.html"
    },
    {
      "source": "/firebase-config.js",
      "destination": "/VANYAVEN/firebase-config.js"
    },
    {
      "source": "/firebase-adapter.js",
      "destination": "/VANYAVEN/firebase-adapter.js"
    },
    {
      "source": "/VANYAVEN/assets/(.*)",
      "destination": "/VANYAVEN/assets/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/VANYAPROD/assets/$1"
    },
    {
      "source": "/",
      "destination": "/VANYAPROD/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/VANYAPROD/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
